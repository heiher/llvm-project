;; One index shared by several loads, and by a load and a store.

define i64 @shared_index(ptr %a, ptr %b, ptr %c, i64 %i) nounwind {
; CHECK-LABEL: shared_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a3, $a3, 3
; CHECK-NEXT:    ldx.d $a0, $a3, $a0
; CHECK-NEXT:    ldx.d $a1, $a3, $a1
; CHECK-NEXT:    ldx.d $a2, $a3, $a2
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    add.d $a0, $a0, $a2
; CHECK-NEXT:    ret
  %pa = getelementptr i64, ptr %a, i64 %i
  %pb = getelementptr i64, ptr %b, i64 %i
  %pc = getelementptr i64, ptr %c, i64 %i
  %va = load i64, ptr %pa
  %vb = load i64, ptr %pb
  %vc = load i64, ptr %pc
  %s0 = add i64 %va, %vb
  %s1 = add i64 %s0, %vc
  ret i64 %s1
}

