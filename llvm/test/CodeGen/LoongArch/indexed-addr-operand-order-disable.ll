; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc --mtriple=loongarch64 --mattr=+d \
; RUN:   --loongarch-enable-regreg-addr-order=false < %s | FileCheck %s

;; The address operands of indexed loads and stores are left alone.

define i64 @ldx_d(ptr %a, i64 %i) nounwind {
; CHECK-LABEL: ldx_d:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
  %p = getelementptr i64, ptr %a, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

define void @stx_d(ptr %a, i64 %i, i64 %v) nounwind {
; CHECK-LABEL: stx_d:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    stx.d $a2, $a0, $a1
; CHECK-NEXT:    ret
  %p = getelementptr i64, ptr %a, i64 %i
  store i64 %v, ptr %p
  ret void
}
