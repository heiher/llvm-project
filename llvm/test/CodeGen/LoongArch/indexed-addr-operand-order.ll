declare i64 @get()

define i64 @index_from_call(ptr %a) nounwind {
; CHECK-LABEL: index_from_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi.d $sp, $sp, -16
; CHECK-NEXT:    st.d $ra, $sp, 8 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 0 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a0
; CHECK-NEXT:    pcaddu18i $ra, %call36(get)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    ldx.d $a0, $a0, $fp
; CHECK-NEXT:    ld.d $fp, $sp, 0 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 8 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 16
; CHECK-NEXT:    ret
  %i = call i64 @get()
  %p = getelementptr i8, ptr %a, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

;; What is computed before a call counts like anything else: the base is the
;; deeper operand.
define i64 @base_before_call(ptr %a, i64 %x, i64 %y, i64 %i) nounwind {
; CHECK-LABEL: base_before_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi.d $sp, $sp, -32
; CHECK-NEXT:    st.d $ra, $sp, 24 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 16 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s0, $sp, 8 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a3
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    xor $s0, $a0, $a2
; CHECK-NEXT:    bstrins.d $s0, $zero, 5, 0
; CHECK-NEXT:    pcaddu18i $ra, %call36(get)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    slli.d $a1, $fp, 3
; CHECK-NEXT:    ldx.d $a1, $s0, $a1
; CHECK-NEXT:    add.d $a0, $a1, $a0
; CHECK-NEXT:    ld.d $s0, $sp, 8 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $fp, $sp, 16 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 24 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 32
; CHECK-NEXT:    ret
  %b = getelementptr i8, ptr %a, i64 %x
  %bi = ptrtoint ptr %b to i64
  %b2 = xor i64 %bi, %y
  %b3 = and i64 %b2, -64
  %base = inttoptr i64 %b3 to ptr
  %r = call i64 @get()
  %p = getelementptr i64, ptr %base, i64 %i
  %v = load i64, ptr %p
  %s = add i64 %v, %r
  ret i64 %s
}

;; Here it is the base, and the index is computed in the block that follows the
;; call. (No difference could be measured for either order.)
declare ptr @alloc(i64)

define void @call_result_base(i64 %n, i64 %i, i64 %v) nounwind {
; CHECK-LABEL: call_result_base:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $sp, $sp, -32
; CHECK-NEXT:    st.d $ra, $sp, 24 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 16 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s0, $sp, 8 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a2
; CHECK-NEXT:    move $s0, $a1
; CHECK-NEXT:    pcaddu18i $ra, %call36(alloc)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    beqz $a0, .LBB39_2
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    slli.d $a1, $s0, 3
; CHECK-NEXT:    stx.d $fp, $a0, $a1
; CHECK-NEXT:  .LBB39_2: # %exit
; CHECK-NEXT:    ld.d $s0, $sp, 8 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $fp, $sp, 16 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 24 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 32
; CHECK-NEXT:    ret
entry:
  %base = call ptr @alloc(i64 %n)
  %c = icmp eq ptr %base, null
  br i1 %c, label %exit, label %then
then:
  %p = getelementptr i64, ptr %base, i64 %i
  store i64 %v, ptr %p
  br label %exit
exit:
  ret void
}

define i64 @call_result_base_load(i64 %n, i64 %i) nounwind {
; CHECK-LABEL: call_result_base_load:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $sp, $sp, -16
; CHECK-NEXT:    st.d $ra, $sp, 8 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 0 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a1
; CHECK-NEXT:    pcaddu18i $ra, %call36(alloc)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    beqz $a0, .LBB40_2
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    slli.d $a1, $fp, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    b .LBB40_3
; CHECK-NEXT:  .LBB40_2: # %exit
; CHECK-NEXT:    move $a0, $zero
; CHECK-NEXT:  .LBB40_3: # %exit
; CHECK-NEXT:    ld.d $fp, $sp, 0 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 8 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 16
; CHECK-NEXT:    ret
entry:
  %base = call ptr @alloc(i64 %n)
  %c = icmp eq ptr %base, null
  br i1 %c, label %exit, label %then
then:
  %p = getelementptr i64, ptr %base, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
exit:
  ret i64 0
}

;; Dependency chains are followed into the preceding blocks of the trace. Here
;; the base is loaded in the entry block and is later than the shifted index
;; if %pp and %i become available together: 9 cycles with the base in rj and 10
;; with the index in rj. With the result fed back into %pp only it is 7 and 8.
;; This is a guess, though: with the result fed back into %i only, it is the
;; index in rj that is faster, 6 cycles instead of 7. Ordering the operands by
;; "computed in this block" alone always picks the index.
define i64 @loaded_base_other_block(ptr %pp, i64 %i) nounwind {
; CHECK-LABEL: loaded_base_other_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    ld.d $a0, $a0, 0
; CHECK-NEXT:    beqz $a0, .LBB41_2
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB41_2: # %exit
; CHECK-NEXT:    move $a0, $zero
; CHECK-NEXT:    ret
entry:
  %base = load ptr, ptr %pp
  %c = icmp eq ptr %base, null
  br i1 %c, label %exit, label %then
then:
  %p = getelementptr i64, ptr %base, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
exit:
  ret i64 0
}

;; Likewise with a base that is three instructions deep in the entry block,
;; with the same cycle counts.
define i64 @deeper_base_other_block(ptr %a, i64 %x, i64 %y, i64 %i) nounwind {
; CHECK-LABEL: deeper_base_other_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    xor $a0, $a0, $a2
; CHECK-NEXT:    bstrins.d $a0, $zero, 5, 0
; CHECK-NEXT:    beqz $a0, .LBB42_2
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    slli.d $a1, $a3, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB42_2: # %exit
; CHECK-NEXT:    move $a0, $zero
; CHECK-NEXT:    ret
entry:
  %b = getelementptr i8, ptr %a, i64 %x
  %bi = ptrtoint ptr %b to i64
  %b2 = xor i64 %bi, %y
  %b3 = and i64 %b2, -64
  %c = icmp eq i64 %b3, 0
  br i1 %c, label %exit, label %then
then:
  %base = inttoptr i64 %b3 to ptr
  %p = getelementptr i64, ptr %base, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
exit:
  ret i64 0
}

;; Loops: the operand on the loop-carried dependency through the load is the
;; one that matters.

;; i = t[i].x with 32-byte elements.
define i64 @chase_scaled(ptr %t, i64 %i0, i64 %n) nounwind {
; CHECK-LABEL: chase_scaled:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a3, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB43_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    slli.d $a1, $a1, 5
; CHECK-NEXT:    ldx.d $a1, $a1, $a0
; CHECK-NEXT:    addi.d $a3, $a3, 1
; CHECK-NEXT:    blt $a3, $a2, .LBB43_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %i = phi i64 [ %i0, %entry ], [ %i.next, %loop ]
  %p = getelementptr [4 x i64], ptr %t, i64 %i
  %i.next = load i64, ptr %p
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %i.next
}

;; off = *(base + off) & mask: both operands are live-in to the block, and the
;; index comes from an ALU instruction of the previous iteration. 5 cycles with
;; the index in rj, 6 with the base.
define i64 @chase_masked(ptr %t, i64 %i0, i64 %m, i64 %n) nounwind {
; CHECK-LABEL: chase_masked:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a4, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB44_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldx.d $a1, $a1, $a0
; CHECK-NEXT:    addi.d $a4, $a4, 1
; CHECK-NEXT:    and $a1, $a1, $a2
; CHECK-NEXT:    blt $a4, $a3, .LBB44_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %i = phi i64 [ %i0, %entry ], [ %i.next, %loop ]
  %p = getelementptr i8, ptr %t, i64 %i
  %v = load i64, ptr %p
  %i.next = and i64 %v, %m
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %i.next
}

;; off = *(base + off): the index comes straight from an indexed load, which
;; is not forwarded any later to rk.
define i64 @chase_direct(ptr %t, i64 %i0, i64 %n) nounwind {
; CHECK-LABEL: chase_direct:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a3, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB45_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldx.d $a1, $a0, $a1
; CHECK-NEXT:    addi.d $a3, $a3, 1
; CHECK-NEXT:    blt $a3, $a2, .LBB45_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %i = phi i64 [ %i0, %entry ], [ %i.next, %loop ]
  %p = getelementptr i8, ptr %t, i64 %i
  %i.next = load i64, ptr %p
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %i.next
}

;; The pointer is loop-carried, the offset is computed in the block but does
;; not depend on the load: the pointer stays in rj. 5 cycles; 6 with the offset
;; in rj.
define ptr @chase_ptr_computed_offset(ptr %p0, ptr %tbl, i64 %n) nounwind {
; CHECK-LABEL: chase_ptr_computed_offset:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a3, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB46_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    andi $a4, $a3, 56
; CHECK-NEXT:    ldx.d $a0, $a0, $a4
; CHECK-NEXT:    addi.d $a3, $a3, 1
; CHECK-NEXT:    add.d $a0, $a1, $a0
; CHECK-NEXT:    blt $a3, $a2, .LBB46_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %p = phi ptr [ %p0, %entry ], [ %p.next, %loop ]
  %off = and i64 %k, 56
  %a = getelementptr i8, ptr %p, i64 %off
  %v = load i64, ptr %a
  %p.next = getelementptr i8, ptr %tbl, i64 %v
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret ptr %p.next
}

;; n = arena + n->child[key[k]]: likewise with a loaded and scaled offset, 5
;; cycles and 6. The induction variable is later than the loop invariant key
;; pointer.
define ptr @chase_ptr_loaded_offset(ptr %n0, ptr %arena, ptr %key, i64 %len) nounwind {
; CHECK-LABEL: chase_ptr_loaded_offset:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a4, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB47_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldx.bu $a5, $a4, $a2
; CHECK-NEXT:    slli.d $a5, $a5, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a5
; CHECK-NEXT:    addi.d $a4, $a4, 1
; CHECK-NEXT:    add.d $a0, $a1, $a0
; CHECK-NEXT:    blt $a4, $a3, .LBB47_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %n = phi ptr [ %n0, %entry ], [ %n.next, %loop ]
  %pk = getelementptr i8, ptr %key, i64 %k
  %b = load i8, ptr %pk
  %idx = zext i8 %b to i64
  %pc = getelementptr i64, ptr %n, i64 %idx
  %v = load i64, ptr %pc
  %n.next = getelementptr i8, ptr %arena, i64 %v
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %len
  br i1 %c, label %loop, label %exit
exit:
  ret ptr %n.next
}

;; Both operands are on the loop-carried dependency: the longer chain in rj.
;; 7 cycles instead of 8.
define i64 @chase_both(ptr %t, i64 %i0, i64 %m, i64 %n) nounwind {
; CHECK-LABEL: chase_both:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a4, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB48_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    xor $a5, $a1, $a2
; CHECK-NEXT:    bstrins.d $a1, $zero, 11, 0
; CHECK-NEXT:    add.d $a5, $a5, $a2
; CHECK-NEXT:    andi $a5, $a5, 4088
; CHECK-NEXT:    add.d $a1, $a0, $a1
; CHECK-NEXT:    ldx.d $a1, $a5, $a1
; CHECK-NEXT:    addi.d $a4, $a4, 1
; CHECK-NEXT:    blt $a4, $a3, .LBB48_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %i = phi i64 [ %i0, %entry ], [ %i.next, %loop ]
  %hi = and i64 %i, -4096
  %x = xor i64 %i, %m
  %y = add i64 %x, %m
  %lo = and i64 %y, 4088
  %bp = getelementptr i8, ptr %t, i64 %hi
  %p = getelementptr i8, ptr %bp, i64 %lo
  %i.next = load i64, ptr %p
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %i.next
}

;; A value computed in the outer loop is invariant in the inner loop.
define i64 @outer_loop_base(ptr %t, i64 %n, i64 %m) nounwind {
; CHECK-LABEL: outer_loop_base:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a4, $zero
; CHECK-NEXT:    move $a3, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB49_1: # %outer
; CHECK-NEXT:    # =>This Loop Header: Depth=1
; CHECK-NEXT:    # Child Loop BB49_2 Depth 2
; CHECK-NEXT:    move $a5, $zero
; CHECK-NEXT:    slli.d $a6, $a4, 10
; CHECK-NEXT:    add.d $a6, $a0, $a6
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB49_2: # %inner
; CHECK-NEXT:    # Parent Loop BB49_1 Depth=1
; CHECK-NEXT:    # => This Inner Loop Header: Depth=2
; CHECK-NEXT:    andi $a7, $a3, 1016
; CHECK-NEXT:    ldx.d $a7, $a7, $a6
; CHECK-NEXT:    addi.d $a5, $a5, 1
; CHECK-NEXT:    add.d $a3, $a7, $a3
; CHECK-NEXT:    blt $a5, $a2, .LBB49_2
; CHECK-NEXT:  # %bb.3: # %outer.latch
; CHECK-NEXT:    # in Loop: Header=BB49_1 Depth=1
; CHECK-NEXT:    addi.d $a4, $a4, 1
; CHECK-NEXT:    blt $a4, $a1, .LBB49_1
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    move $a0, $a3
; CHECK-NEXT:    ret
entry:
  br label %outer
outer:
  %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
  %acc = phi i64 [ 0, %entry ], [ %s, %outer.latch ]
  %row = shl i64 %j, 10
  %base = getelementptr i8, ptr %t, i64 %row
  br label %inner
inner:
  %k = phi i64 [ 0, %outer ], [ %k.next, %inner ]
  %i = phi i64 [ %acc, %outer ], [ %s, %inner ]
  %off = and i64 %i, 1016
  %p = getelementptr i8, ptr %base, i64 %off
  %v = load i64, ptr %p
  %s = add i64 %v, %i
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %m
  br i1 %c, label %inner, label %outer.latch
outer.latch:
  %j.next = add i64 %j, 1
  %oc = icmp slt i64 %j.next, %n
  br i1 %oc, label %outer, label %exit
exit:
  ret i64 %s
}

;; Not run for optnone functions.
define i64 @optnone(ptr %a, i64 %i) nounwind optnone noinline {
; CHECK-LABEL: optnone:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
  %p = getelementptr i64, ptr %a, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}
