# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc --mtriple=loongarch64 --mattr=+d --run-pass=loongarch-regreg-addr-order \
# RUN:   --verify-machineinstrs %s -o - | FileCheck %s

## The address operand of an indexed load/store that arrives later is moved to
## rj, together with its kill flag.

---
name:            kill_flags
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: kill_flags
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[SLLI_D:%[0-9]+]]:gpr = SLLI_D [[COPY]], 3
    ; CHECK-NEXT: [[LDX_D:%[0-9]+]]:gpr = LDX_D killed [[SLLI_D]], [[COPY1]] :: (load (s64))
    ; CHECK-NEXT: $r4 = COPY [[LDX_D]]
    ; CHECK-NEXT: $r5 = COPY [[COPY1]]
    ; CHECK-NEXT: PseudoRET implicit $r4, implicit $r5
    %1:gpr = COPY $r5
    %0:gpr = COPY $r4
    %2:gpr = SLLI_D %1, 3
    %3:gpr = LDX_D %0, killed %2 :: (load (s64))
    $r4 = COPY %3
    $r5 = COPY %0
    PseudoRET implicit $r4, implicit $r5
...

## Already in the right order.
---
name:            index_in_rj
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: index_in_rj
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[SLLI_D:%[0-9]+]]:gpr = SLLI_D [[COPY]], 3
    ; CHECK-NEXT: [[LDX_D:%[0-9]+]]:gpr = LDX_D killed [[SLLI_D]], killed [[COPY1]] :: (load (s64))
    ; CHECK-NEXT: $r4 = COPY [[LDX_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %1:gpr = COPY $r5
    %0:gpr = COPY $r4
    %2:gpr = SLLI_D %1, 3
    %3:gpr = LDX_D killed %2, killed %0 :: (load (s64))
    $r4 = COPY %3
    PseudoRET implicit $r4
...

---
name:            same_reg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4

    ; CHECK-LABEL: name: same_reg
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[COPY]], 8
    ; CHECK-NEXT: [[LDX_D:%[0-9]+]]:gpr = LDX_D [[ADDI_D]], [[ADDI_D]] :: (load (s64))
    ; CHECK-NEXT: $r4 = COPY [[LDX_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = COPY $r4
    %1:gpr = ADDI_D %0, 8
    %2:gpr = LDX_D %1, %1 :: (load (s64))
    $r4 = COPY %2
    PseudoRET implicit $r4
...

## The result of a multiplication or of a move from an FP register is not
## forwarded any later to rk.
---
name:            slow_producers
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6, $f0_64

    ; CHECK-LABEL: name: slow_producers
    ; CHECK: liveins: $r4, $r5, $r6, $f0_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY $r6
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fpr64 = COPY $f0_64
    ; CHECK-NEXT: [[MUL_D:%[0-9]+]]:gpr = MUL_D [[COPY1]], [[COPY2]]
    ; CHECK-NEXT: [[LDX_D:%[0-9]+]]:gpr = LDX_D [[COPY]], [[MUL_D]] :: (load (s64))
    ; CHECK-NEXT: [[MOVFR2GR_D:%[0-9]+]]:gpr = MOVFR2GR_D [[COPY3]]
    ; CHECK-NEXT: [[LDX_D1:%[0-9]+]]:gpr = LDX_D [[COPY]], [[MOVFR2GR_D]] :: (load (s64))
    ; CHECK-NEXT: [[ADD_D:%[0-9]+]]:gpr = ADD_D [[LDX_D]], [[LDX_D1]]
    ; CHECK-NEXT: $r4 = COPY [[ADD_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = COPY $r6
    %3:fpr64 = COPY $f0_64
    %4:gpr = MUL_D %1, %2
    %5:gpr = LDX_D %0, %4 :: (load (s64))
    %6:gpr = MOVFR2GR_D %3
    %7:gpr = LDX_D %0, %6 :: (load (s64))
    %8:gpr = ADD_D %5, %7
    $r4 = COPY %8
    PseudoRET implicit $r4
...

## An induction variable is later than a loop invariant base.
---
name:            iv_store
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: iv_store
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $r6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r6
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r5
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $r4
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY3]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   STX_D [[COPY1]], [[PHI]], [[COPY2]] :: (store (s64))
  ; CHECK-NEXT:   [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PHI]], 8
  ; CHECK-NEXT:   BLT [[ADDI_D]], [[COPY]], %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    liveins: $r4, $r5, $r6

    %4:gpr = COPY $r6
    %3:gpr = COPY $r5
    %2:gpr = COPY $r4
    %5:gpr = COPY $r0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)

    %0:gpr = PHI %5, %bb.0, %1, %bb.1
    STX_D %3, %2, %0 :: (store (s64))
    %1:gpr = ADDI_D %0, 8
    BLT %1, %4, %bb.1
    PseudoBR %bb.2

  bb.2:
    PseudoRET
...

## The index is on a loop-carried dependency through the load and is produced
## by an ALU instruction.
---
name:            recurrence_alu
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: recurrence_alu
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $r6, $r7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r7
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r6
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $r5
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr = COPY $r4
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY4]], %bb.0, %6, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr = PHI [[COPY2]], %bb.0, %8, %bb.1
  ; CHECK-NEXT:   [[LDX_D:%[0-9]+]]:gpr = LDX_D [[PHI1]], [[COPY3]] :: (load (s64))
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:gpr = AND [[LDX_D]], [[COPY1]]
  ; CHECK-NEXT:   [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PHI]], 1
  ; CHECK-NEXT:   BLT [[ADDI_D]], [[COPY]], %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r4 = COPY [[AND]]
  ; CHECK-NEXT:   PseudoRET implicit $r4
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    %7:gpr = COPY $r7
    %6:gpr = COPY $r6
    %5:gpr = COPY $r5
    %4:gpr = COPY $r4
    %8:gpr = COPY $r0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)

    %0:gpr = PHI %8, %bb.0, %3, %bb.1
    %1:gpr = PHI %5, %bb.0, %2, %bb.1
    %10:gpr = LDX_D %4, %1 :: (load (s64))
    %2:gpr = AND %10, %6
    %3:gpr = ADDI_D %0, 1
    BLT %3, %7, %bb.1
    PseudoBR %bb.2

  bb.2:
    $r4 = COPY %2
    PseudoRET implicit $r4
...

## The loop-carried index comes straight from the indexed load, or from a
## multiplication: no extra cycle in rk.
---
name:            recurrence_ldx
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: recurrence_ldx
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $r7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r7
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r5
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $r4
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY3]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr = PHI [[COPY1]], %bb.0, %7, %bb.1
  ; CHECK-NEXT:   [[LDX_D:%[0-9]+]]:gpr = LDX_D [[COPY2]], [[PHI1]] :: (load (s64))
  ; CHECK-NEXT:   [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PHI]], 1
  ; CHECK-NEXT:   BLT [[ADDI_D]], [[COPY]], %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r4 = COPY [[LDX_D]]
  ; CHECK-NEXT:   PseudoRET implicit $r4
  bb.0:
    liveins: $r4, $r5, $r7

    %7:gpr = COPY $r7
    %5:gpr = COPY $r5
    %4:gpr = COPY $r4
    %8:gpr = COPY $r0

  bb.1:
