;; Both operands are computed in the block: the deeper one goes to rj. For
;; @deeper_index this takes 8 cycles instead of 9 when the result is fed back
;; into %x and 9 instead of 10 when it is fed back into both %a and %x, but 7
;; instead of 6 when it is fed back into %a only. Looking at the function
;; alone, the longer chain is the best guess.

define i64 @deeper_index(ptr %a, i64 %x, i64 %y, i64 %z) nounwind {
; CHECK-LABEL: deeper_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a1, $a1, $a2
; CHECK-NEXT:    add.d $a1, $a1, $a3
; CHECK-NEXT:    andi $a1, $a1, 4088
; CHECK-NEXT:    add.d $a0, $a0, $a2
; CHECK-NEXT:    bstrins.d $a0, $zero, 5, 0
; CHECK-NEXT:    ldx.d $a0, $a1, $a0
; CHECK-NEXT:    ret
  %i1 = xor i64 %x, %y
  %i2 = add i64 %i1, %z
  %i3 = and i64 %i2, 4088
  %b = getelementptr i8, ptr %a, i64 %y
  %bi = ptrtoint ptr %b to i64
  %b2 = and i64 %bi, -64
  %base = inttoptr i64 %b2 to ptr
  %p = getelementptr i8, ptr %base, i64 %i3
  %v = load i64, ptr %p
  ret i64 %v
}

define i64 @deeper_base(ptr %a, i64 %x, i64 %y, i64 %i) nounwind {
; CHECK-LABEL: deeper_base:
; CHECK:       # %bb.0:
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    xor $a0, $a0, $a2
; CHECK-NEXT:    bstrins.d $a0, $zero, 5, 0
; CHECK-NEXT:    slli.d $a1, $a3, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
  %b = getelementptr i8, ptr %a, i64 %x
  %bi = ptrtoint ptr %b to i64
  %b2 = xor i64 %bi, %y
  %b3 = and i64 %b2, -64
  %base = inttoptr i64 %b3 to ptr
  %p = getelementptr i64, ptr %base, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

