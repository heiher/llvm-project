## The loop-carried pointer is later than an offset that is computed in the
## block from the induction variable.
---
name:            recurrence_vs_local
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: recurrence_vs_local
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $r6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r6
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r5
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $r4
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr = COPY $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY3]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr = PHI [[COPY2]], %bb.0, %7, %bb.1
  ; CHECK-NEXT:   [[ANDI:%[0-9]+]]:gpr = ANDI [[PHI]], 56
  ; CHECK-NEXT:   [[LDX_D:%[0-9]+]]:gpr = LDX_D [[PHI1]], killed [[ANDI]] :: (load (s64))
  ; CHECK-NEXT:   [[ADD_D:%[0-9]+]]:gpr = ADD_D [[COPY1]], killed [[LDX_D]]
  ; CHECK-NEXT:   [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PHI]], 1
  ; CHECK-NEXT:   BLT [[ADDI_D]], [[COPY]], %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r4 = COPY [[ADD_D]]
  ; CHECK-NEXT:   PseudoRET implicit $r4
  bb.0:
    liveins: $r4, $r5, $r6

    %6:gpr = COPY $r6
    %5:gpr = COPY $r5
    %4:gpr = COPY $r4
    %8:gpr = COPY $r0

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)

    %0:gpr = PHI %8, %bb.0, %3, %bb.1
    %1:gpr = PHI %4, %bb.0, %2, %bb.1
    %9:gpr = ANDI %0, 56
    %10:gpr = LDX_D killed %9, %1 :: (load (s64))
    %2:gpr = ADD_D %5, killed %10
    %3:gpr = ADDI_D %0, 1
    BLT %3, %6, %bb.1
    PseudoBR %bb.2

  bb.2:
    $r4 = COPY %2
    PseudoRET implicit $r4
...
