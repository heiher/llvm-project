;; On LA664 and earlier micro-architectures a value produced by a single-cycle
;; integer instruction or by a reg+imm load reaches the rk operand of an
;; indexed load/store one cycle later than rj. The address operand that
;; arrives later must be placed in rj.
;;
;; The cycle counts in the comments were measured on a 3A6000 (LA664): per
;; iteration for the loops, and per call for the other functions when they are
;; called in a chain that feeds the result back into the named argument.

;; The index is computed, the base is live-in.

define i64 @ldx_d(ptr %a, i64 %i) nounwind {
; CHECK-LABEL: ldx_d:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a1, $a0
; CHECK-NEXT:    ret
  %p = getelementptr i64, ptr %a, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

define i64 @ldx_w(ptr %a, i64 %i) nounwind {
; CHECK-LABEL: ldx_w:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 2
; CHECK-NEXT:    ldx.w $a0, $a1, $a0
; CHECK-NEXT:    ret
  %p = getelementptr i32, ptr %a, i64 %i
  %v = load i32, ptr %p
