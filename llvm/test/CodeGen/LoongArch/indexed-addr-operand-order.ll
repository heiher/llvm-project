declare void @use(ptr)

define i64 @frame_index(i64 %i) nounwind {
; CHECK-LABEL: frame_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi.d $sp, $sp, -160
; CHECK-NEXT:    st.d $ra, $sp, 152 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 144 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s0, $sp, 136 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a0
; CHECK-NEXT:    addi.d $a0, $sp, 8
; CHECK-NEXT:    addi.d $s0, $sp, 8
; CHECK-NEXT:    pcaddu18i $ra, %call36(use)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    slli.d $a0, $fp, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $s0
; CHECK-NEXT:    ld.d $s0, $sp, 136 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $fp, $sp, 144 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 152 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 160
; CHECK-NEXT:    ret
  %buf = alloca [16 x i64], align 8
  call void @use(ptr %buf)
  %p = getelementptr i64, ptr %buf, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

define i64 @jump_table(i64 %x, ptr %out) nounwind {
; CHECK-LABEL: jump_table:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $a2, $a0, -1
; CHECK-NEXT:    ori $a3, $zero, 4
; CHECK-NEXT:    bltu $a3, $a2, .LBB36_8
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    slli.d $a2, $a2, 3
; CHECK-NEXT:    pcalau12i $a3, %pc_hi20(.LJTI36_0)
; CHECK-NEXT:    addi.d $a3, $a3, %pc_lo12(.LJTI36_0)
; CHECK-NEXT:    ldx.d $a2, $a2, $a3
; CHECK-NEXT:    jr $a2
; CHECK-NEXT:  .LBB36_2: # %bb1
; CHECK-NEXT:    ori $a2, $zero, 4
; CHECK-NEXT:    b .LBB36_7
; CHECK-NEXT:  .LBB36_3: # %bb5
; CHECK-NEXT:    ori $a2, $zero, 9
; CHECK-NEXT:    b .LBB36_7
; CHECK-NEXT:  .LBB36_4: # %bb3
; CHECK-NEXT:    ori $a2, $zero, 2
; CHECK-NEXT:    b .LBB36_7
; CHECK-NEXT:  .LBB36_5: # %bb4
; CHECK-NEXT:    ori $a2, $zero, 1
; CHECK-NEXT:    b .LBB36_7
; CHECK-NEXT:  .LBB36_6: # %bb2
; CHECK-NEXT:    ori $a2, $zero, 3
; CHECK-NEXT:  .LBB36_7: # %exit
; CHECK-NEXT:    st.d $a2, $a1, 0
; CHECK-NEXT:  .LBB36_8: # %exit
; CHECK-NEXT:    ret
entry:
  switch i64 %x, label %exit [
    i64 1, label %bb1
    i64 2, label %bb2
    i64 3, label %bb3
    i64 4, label %bb4
    i64 5, label %bb5
  ]
bb1:
  store i64 4, ptr %out
  br label %exit
bb2:
  store i64 3, ptr %out
  br label %exit
bb3:
  store i64 2, ptr %out
  br label %exit
bb4:
  store i64 1, ptr %out
  br label %exit
bb5:
  store i64 9, ptr %out
  br label %exit
exit:
  ret i64 %x
}

